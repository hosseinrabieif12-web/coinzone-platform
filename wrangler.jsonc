{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coinzone-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
