# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Cloudflare Pages, add this in Settings > Environment Variables (Encrypted Secret).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional, required for 1-click GitHub OAuth auto-upload.
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# CRYPTOPANIC_API_KEY: Optional CryptoPanic API token for enhanced news wire.
CRYPTOPANIC_API_KEY=""
